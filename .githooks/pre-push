#!/bin/sh
# Sequence guard (L-4): a commit reaches `main` only if it already carries a
# review tag. "Branch -> tag -> verdict -> merge" is not enforceable as a promise;
# this makes the TAG part mechanical, which is the part a hook can see.
#
# Reads pre-push's stdin: <local ref> <local sha> <remote ref> <remote sha>
set -eu
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$remote_ref" = "refs/heads/main" ] || continue
    # Deletions (all-zero sha) are not merges.
    case "$local_sha" in 0000000000000000000000000000000000000000) continue;; esac
    # A documentation-only push needs no tag: the rule exists to stop *code*
    # from reaching main without a measured tree. A new branch (zero remote sha)
    # has no diff to inspect, so it keeps the strict path.
    #
    # "docs-only" means **not compiled**, not "not executable by a person": an
    # executable script created under docs/ passes without a tag. That is
    # accepted because nothing builds or CI-invokes docs/ (no build.rs, and
    # Cargo.toml has zero references to it) — if that ever changes, the prefix
    # must grow to cover the invoking path too.
    #
    # Adversarial cases measured: docs/ + code in one push → strict; a path like
    # src/docs/x.rs → strict (the prefix is ^docs/, anchored); deleting a code
    # file → strict; a newline in the filename → strict (git quotes it, so it
    # does not start with docs/); modifying .githooks/pre-push itself → strict.
    # An exemption that covered the guard would be a door that opens from inside.
    docs_only=no
    case "$remote_sha" in
        0000000000000000000000000000000000000000) ;;
        *)
            if paths=$(git diff --name-only "$remote_sha..$local_sha" 2>/dev/null); then
                if [ -n "$paths" ] && ! printf '%s\n' "$paths" | grep -qv '^docs/'; then
                    docs_only=yes
                fi
            fi
            ;;
    esac
    if [ "$docs_only" = yes ]; then
        echo "pre-push: $local_sha touches docs/ only — no review tag needed."
        continue
    fi

    tags=$(git tag --points-at "$local_sha" | grep '^review/' || true)
    if [ -z "$tags" ]; then
        echo "pre-push: $local_sha is going to main with no review tag on it." >&2
        echo "pre-push: tag the reviewed tree first (git tag review/<name> $local_sha && git push origin review/<name>)." >&2
        echo "pre-push: the push was refused." >&2
        status=1
    else
        echo "pre-push: $local_sha carries $(echo "$tags" | tr '\n' ' ')- the tag exists; the verdict is a human step."
    fi
done
exit "$status"
