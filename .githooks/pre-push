#!/bin/sh
# Sequence guard (L-4): a commit reaches `main` only if it already carries a
# review tag. "Branch -> tag -> verdict -> merge" is not enforceable as a promise;
# this makes the TAG part mechanical, which is the part a hook can see.
#
# Reads pre-push's stdin: <local ref> <local sha> <remote ref> <remote sha>
set -eu
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$remote_ref" = "refs/heads/main" ] || continue
    # Deletions (all-zero sha) are not merges.
    case "$local_sha" in 0000000000000000000000000000000000000000) continue;; esac
    # A documentation-only push needs no tag: the rule exists to stop *code*
    # from reaching main without a measured tree. A new branch (zero remote sha)
    # has no diff to inspect, so it keeps the strict path.
    #
    # "docs-only" means **not compiled**, not "not executable by a person": an
    # executable script created under docs/ passes without a tag. That is
    # accepted because nothing builds or CI-invokes docs/ (no build.rs, and
    # Cargo.toml has zero references to it) — if that ever changes, the prefix
    # must grow to cover the invoking path too.
    #
    # Adversarial cases measured: docs/ + code in one push → strict; a path like
    # src/docs/x.rs → strict (the prefix is ^docs/, anchored); deleting a code
    # file → strict; a newline in the filename → strict (git quotes it, so it
    # does not start with docs/); modifying .githooks/pre-push itself → strict.
    # An exemption that covered the guard would be a door that opens from inside.
    #
    # Reproduce (the measurement, not the claim): in a scratch clone, make each
    # change below and `git push origin HEAD:main` with no review tag on the tip.
    # Expected rc: docs/ only → 0; docs/ + code → 1; src/docs/x.rs → 1; deleting a
    # code file → 1; a filename containing a newline → 1; modifying this file → 1;
    # a new branch (zero remote sha) → 1. Full matrix: docs/probes.md.
    docs_only=no
    case "$remote_sha" in
        0000000000000000000000000000000000000000) ;;
        *)
            if paths=$(git diff --name-only "$remote_sha..$local_sha" 2>/dev/null); then
                if [ -n "$paths" ] && ! printf '%s\n' "$paths" | grep -qv '^docs/'; then
                    docs_only=yes
                fi
            fi
            ;;
    esac
    if [ "$docs_only" = yes ]; then
        echo "pre-push: $local_sha touches docs/ only — no review tag needed."
        continue
    fi

    tags=$(git tag --points-at "$local_sha" | grep '^review/' || true)
    if [ -z "$tags" ]; then
        echo "pre-push: $local_sha is going to main with no review tag on it." >&2
        echo "pre-push: tag the reviewed tree first (git tag review/<name> $local_sha && git push origin review/<name>)." >&2
        echo "pre-push: the push was refused." >&2
        status=1
    else
        # H-4: a local tag is not a published tag. `--points-at` sees this clone
        # only, so a second person (or a rebase that moves the tag) can push code
        # whose tag never left the machine. Ask the remote, when it answers.
        # H-5: bind the verdict to the TREE, not to a string. Comparing the tag
        # name let a published tag on a *different* commit satisfy the guard
        # (exactly the rebase case that motivated H-4), and `grep` read `.` in a
        # name as "any character". awk compares sha and ref exactly.
        #
        # The `else` below is unreachable in a *real* push while url == pushurl:
        # git itself fails (exit 128) before the hook's verdict matters. It is
        # reachable (a) with a pushurl different from url, and (b) whenever the
        # hook is invoked directly — which is what scripts/install-hooks.sh does
        # with file:///nonexistent-remote. So it is a live fallback, not dead
        # code, and it must stay loud: a silent pass here would hide the fact
        # that the tag was never checked against anything.
        verified=no
        if remote_tags=$(git ls-remote --tags --refs "$2" 2>/dev/null); then
            for tag in $tags; do
                if printf '%s\n' "$remote_tags" \
                    | awk -v s="$local_sha" -v r="refs/tags/$tag" '$1==s && $2==r {f=1} END{exit !f}'; then
                    verified=yes
                    break
                fi
            done
            if [ "$verified" != yes ]; then
                echo "pre-push: $local_sha carries $(echo "$tags" | tr '\n' ' ') locally, but the remote has no such tag on THIS commit." >&2
                echo "pre-push: push the tag on the commit being pushed (git tag -f <tag> $local_sha && git push -f origin <tag>)." >&2
                echo "pre-push: the push was refused." >&2
                status=1
                continue
            fi
        else
            echo "pre-push: the remote could not be reached; the tag was not verified against it." >&2
        fi
        echo "pre-push: $local_sha carries $(echo "$tags" | tr '\n' ' ')- the tag is published on this commit; the verdict is a human step."
    fi
done
exit "$status"
